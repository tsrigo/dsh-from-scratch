{
  "name": "dsh-from-scratch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:python": "python -m unittest discover -s tests_python -v",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx src/cli.ts --provider fake",
    "dev": "tsx src/cli.ts",
    "python:hello": "tsx scripts/run-python-hello.ts",
    "replay:record": "tsx scripts/record-live-replay.ts",
    "tutorial:generate": "tsx scripts/generate-tutorial-data.ts && TUTORIAL_LOCALE=en tsx scripts/generate-tutorial-data.ts && tsx scripts/generate-python-tutorial-data.ts",
    "site:dev": "vite --config website/vite.config.ts",
    "site:build": "vite build --config website/vite.config.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
